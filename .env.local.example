# Copy this file to .env.local and fill in your Supabase project's values.
# Both are server-only env vars (no NEXT_PUBLIC_ prefix) — never expose the
# anon key to the client bundle for this app; it should only be read from
# the /api/waitlist route handler, which relies on the insert-only RLS
# policy in supabase/waitlist.sql to stay safe if it ever leaks.
SUPABASE_URL=
SUPABASE_ANON_KEY=
